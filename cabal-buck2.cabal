cabal-version:      3.8
name:               cabal-buck2
version:            0.6.0.0

-- To ship a new version:
--   - bump the version above
--   - update the changelog & README
--   - push the changes to the master branch of cabal-buck2
--   - create a branch A.B.C.D on haskell-buck2
--   - push an update to `version.bzl` for A.B.C.D on that branch
--   - update the buck2 submodule to that branch (the sdist includes it)
--   - cabal install locally, and check it on a local repo
--   - wait for CI on cabal-buck2
--   - cabal sdist, cabal upload, check the candidate
--   - git tag the version A.B.C.D
--   - cabal upload --publish

synopsis:           Build a Cabal project with buck2 (the `cabal buck2` external command)
license:            BSD-3-Clause
build-type:         Simple
author:             Simon Marlow <marlowsd@gmail.com>
maintainer:         Simon Marlow <marlowsd@gmail.com>
category:           Build Tool
description:
  This is a [Cabal external command](https://cabal.readthedocs.io/en/stable/external-commands.html) `cabal buck2` that allows
  you to use [Buck2](https://buck2.build) as the build system for your
  Cabal project. For more details see the package README.

tested-with:        GHC==9.14.1, GHC==9.12.4, GHC==9.10.3, GHC==9.8.2, GHC==9.6.4, GHC==9.4.8

extra-doc-files:    README.md, changelog.md
extra-source-files:
  test/fixtures/**/*.c
  test/fixtures/**/*.cmm
  test/fixtures/**/*.S
  test/fixtures/**/*.js
  test/fixtures/**/*.ly
  test/fixtures/**/*.cabal
  test/fixtures/**/*.h
  test/fixtures/**/*.hs
  test/fixtures/**/*.hs-boot
  test/fixtures/**/*.pc
  test/fixtures/**/*.project
  test/fixtures/**/.buckconfig
  test/fixtures/**/.gitkeep
  test/fixtures/**/PACKAGE
  test/fixtures/**/*.txt

-- The buck2 support code (the haskell-buck2 submodule in buck2/), which
-- `cabal buck2` copies into a project that doesn't have a buck2/ directory.
-- Its tests, its CI and documentation images aren't needed, and neither are
-- the tests of the prelude's Android tooling, which are most of its size.
--
-- A wildcard has to have an extension, so there is a pattern for each kind
-- of file. The data-files test (in test/Main.hs) checks that the patterns
-- match the files of the submodule, apart from those left out.
