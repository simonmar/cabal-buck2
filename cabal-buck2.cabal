homepage:            https://github.com/simonmar/cabal-buck2
bug-reports:         https://github.com/simonmar/cabal-buck2/issues

source-repository head
    type: git
    location: https://github.com/simonmar/cabal-buck2.git

common warnings
  ghc-options: -Wall -Wcompat -Wno-unused-do-bind

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions: TypeOperators, NoImportQualifiedPost
  exposed-modules:
    Distribution.Client.CmdBuck2
    Distribution.Client.Buck2.BuildDependencies
    Distribution.Client.Buck2.Cache
    Distribution.Client.Buck2.Configure
    Distribution.Client.Buck2.Fingerprint
    Distribution.Client.Buck2.Flags
    Distribution.Client.Buck2.Generate
    Distribution.Client.Buck2.LocalPackages
    Distribution.Client.Buck2.Prebuilt
    Distribution.Client.Buck2.Schedule
    Distribution.Client.Buck2.Setup
    Distribution.Client.Buck2.Spec
    Distribution.Client.Buck2.Starlark
    Distribution.Client.Buck2.Toolchain
    Distribution.Client.Buck2.Unpack
    Distribution.Client.Buck2.Version
    Distribution.Client.Buck2.Write
  other-modules:
    Paths_cabal_buck2
  autogen-modules:
    Paths_cabal_buck2
  build-depends:
    , async         >=2.2.6 && <2.3
    , base          >=4.17 && <4.24
    , bytestring    >=0.11.5 && <0.13
    , Cabal         ==3.18.*
    , Cabal-syntax  ==3.18.*
    , cabal-install ==3.18.1.0
    , cabal-install-solver ==3.18.*
    , containers    >=0.6.7 && <0.9
    , directory     >=1.3.8 && <1.4
    , filepath      >=1.4 && <1.6
    , process       >=1.6 && <1.7
    , stm           >=2.5.1 && <2.6

executable cabal-buck2
  import:           warnings
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  hs-source-dirs:   app
  default-language: GHC2021
  build-depends:
    , base          >=4.17 && <4.24
    , Cabal
    , cabal-buck2
    , cabal-install

-- `cabal test` runs `cabal-buck2` on the projects in `test/fixtures`
-- and checks the files it generates. The tests don't need buck2, and
-- use a private `CABAL_DIR` and the packages installed with GHC only
-- (the fixtures set `active-repositories: :none`, or a local repository
-- made with `tar`), so they need no network access.

test-suite fixtures
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  hs-source-dirs:     test
  default-language:   GHC2021
  build-tool-depends: cabal-buck2:cabal-buck2
  build-depends:
    , base          >=4.17 && <4.24
    , bytestring    >=0.11.5 && <0.13
    , Cabal
    , cabal-buck2
    , containers    >=0.6.7 && <0.9
    , directory
    , filepath
    , process
