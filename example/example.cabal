cabal-version:      3.0
name:               example
version:            0.1.0.0
build-type:         Simple
synopsis:           Exercises TH, hsc2hs and C++/FFI, to test cabal-buck2 and the buck2 support code.

-- Example.TH is in a library of its own, and Example.Greeters in the same
-- library as Example.Lib, so that Example.Lib has splices using both a
-- module of another library and one of its own library.
library th
  exposed-modules:  Example.TH
  build-depends:    base >=4 && <5, template-haskell
  default-language: Haskell2010

library
  exposed-modules:
      Example.Greeters
      Example.Point
      Example.Lib
  build-depends:
      base >=4 && <5
    , example:th
    , bytestring
    , safe
    , template-haskell
  default-extensions: TemplateHaskell, ForeignFunctionInterface
  include-dirs: cbits
  cxx-sources: cbits/shim.cpp
  cxx-options: -std=c++17
  extra-libraries: stdc++
  default-language: Haskell2010

test-suite example-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
      base
    , example
  default-language: Haskell2010
